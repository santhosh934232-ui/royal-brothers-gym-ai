# ============================================
# Royal Brothers Fitness Gym - Environment Variables
# Copy this file to ".env" for local development and fill in real
# values. NEVER commit the real ".env" file to version control.
#
# In production (e.g. PythonAnywhere), set these as actual
# environment variables / in your WSGI config instead of uploading a
# .env file.
# ============================================

# ---------- Flask ----------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-string

# ---------- Reverse proxy (optional) ----------
# Default is 0: do not trust forwarded headers. Only set this to the exact
# number of reverse-proxy hops controlled by your host when the app is not
# directly exposed; see PHASE_9_HANDOFF.md before enabling.
TRUSTED_PROXY_COUNT=0

# ---------- SQLite Database ----------
# Optional. Path to the SQLite database file. If not set, defaults to
# "royal_brothers_gym.db" in the project root (see app/config.py).
# Uncomment and set this if you want the database file stored
# somewhere else, e.g. on PythonAnywhere:
# DATABASE_PATH=/home/yourusername/royal-brothers-gym/royal_brothers_gym.db

# ---------- Gmail SMTP ----------
# Do NOT use your normal Gmail password.
# Generate a Gmail "App Password" at:
#   Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=replace-with-a-16-character-app-password
MAIL_SENDER_NAME=Royal Brothers Fitness Gym

# ---------- Gemini AI ----------
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
# Paste it ONLY into your local, untracked .env (or your host's
# environment settings) -- never into code or version control.
GEMINI_API_KEY=
# Optional: override the default model (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Membership Reminder Options (Phase 6) ----------
# Optional comma-separated supported lead days; values must be unique,
# between 1 and 30, and include the defaults 7,3,1.
# MEMBERSHIP_REMINDER_ALLOWED_LEAD_DAYS=7,3,1

# ---------- App URL ----------
# Used to build the links inside verification/reset emails.
# Use your real deployed domain in production (e.g. your
# PythonAnywhere URL: https://yourusername.pythonanywhere.com).
# Leave blank to auto-detect from the incoming request during local
# development.
APP_BASE_URL=http://127.0.0.1:5000
